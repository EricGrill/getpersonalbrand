# Required server settings. Replace these placeholders for your own local database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/getpersonalbrand"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Optional URLs. Use localhost:3000 locally and your preview host on preview deployments.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_SITE_URL_MODE="path"

# Optional integrations. Leave blank when unused.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
BLOB_READ_WRITE_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM=""
ADMIN_EMAILS=""
CRON_SECRET=""
ANALYTICS_SALT=""

# Optional: dedicated disposable PostgreSQL database for integration tests only.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/getpersonalbrand_test"
